<Page
    x:Class="BlueScreenHelper.Views.AIPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BlueScreenHelper.Models">

    <Grid Padding="24,16,24,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="AI 诊断助手" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="接入任意 OpenAI 兼容接口（OpenAI / DeepSeek / 智谱 / 通义 / Ollama 等），用 AI 分析崩溃原因并生成解决方案。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <ComboBox x:Name="ModelBox" Grid.Column="1" IsEditable="True" Width="220"
                      VerticalAlignment="Center" Margin="0,0,10,0"
                      ToolTipService.ToolTip="当前模型，可在设置中修改">
            </ComboBox>
            <Button Grid.Column="2" VerticalAlignment="Center" Click="Clear_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Delete" />
                    <TextBlock Text="清空对话" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="4">
            <ListView x:Name="ChatList" SelectionMode="None"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="10,6" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ChatMessage">
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="10" Padding="12,8" MaxWidth="820" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="4">
                                <TextBlock FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           Text="{x:Bind DisplayName}" />
                                <TextBlock Text="{x:Bind Content, Mode=OneWay}" TextWrapping="Wrap" LineHeight="22" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" PlaceholderText="输入问题，例如：0x000000D1 蓝屏如何解决？"
                     AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="140"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     KeyDown="InputBox_KeyDown" />
            <Button x:Name="SendButton" Grid.Column="1" VerticalAlignment="Bottom"
                    Click="Send_Click" Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Send" />
                    <TextBlock Text="发送" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="StopButton" Grid.Column="2" VerticalAlignment="Bottom"
                    Click="Stop_Click" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="Cancel" />
                    <TextBlock Text="停止" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
