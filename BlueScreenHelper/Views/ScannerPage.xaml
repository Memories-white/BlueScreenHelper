<Page
    x:Class="BlueScreenHelper.Views.ScannerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BlueScreenHelper.Models">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,16,24,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="系统全面扫描" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="扫描事件日志、崩溃转储、驱动加载失败、磁盘与内存健康、SMART 状态等关键路径，定位系统问题根源。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Button x:Name="ScanButton" Click="Scan_Click" Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Play" />
                    <TextBlock Text="开始扫描" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <ProgressRing x:Name="ScanRing" IsActive="False" Width="24" Height="24" />
            <TextBlock x:Name="StatusText" Text="点击“开始扫描”检查系统状态" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <InfoBar x:Name="SummaryBar" Grid.Row="2" IsOpen="False" />

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Visibility="Collapsed">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="系统概况" Margin="0,0,0,6" />
                    <TextBlock x:Name="SysText" TextWrapping="Wrap" LineHeight="22" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock FontWeight="SemiBold" Text="扫描操作" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="CopyScanButton" Click="CopyScan_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="Copy" />
                                <TextBlock Text="复制报告" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AiScanButton" Click="AiScan_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="Comment" />
                                <TextBlock Text="AI 分析扫描结果" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ComboBox x:Name="FilterBox" Width="220" HorizontalAlignment="Left"
                      SelectionChanged="FilterBox_SelectionChanged">
                <ComboBoxItem Content="全部问题" Tag="all" IsSelected="True" />
                <ComboBoxItem Content="仅严重问题" Tag="critical" />
                <ComboBoxItem Content="严重 + 警告" Tag="warning" />
                <ComboBoxItem Content="仅提示" Tag="info" />
            </ComboBox>
            <ListView x:Name="IssueList" Grid.Row="1" SelectionMode="None"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ScanIssue">
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,4">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                                            Background="{x:Bind SeverityBrush}" />
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" TextWrapping="Wrap" />
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock FontSize="11" Text="{x:Bind SeverityText}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind Category}" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind Recommendation}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Footer>
                    <StackPanel>
                        <TextBlock x:Name="EmptyText" Text="暂无扫描结果" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,24" />
                    </StackPanel>
                </ListView.Footer>
            </ListView>
        </Grid>
    </Grid>
</Page>
