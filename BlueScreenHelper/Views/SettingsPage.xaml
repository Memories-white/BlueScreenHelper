<Page
    x:Class="BlueScreenHelper.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="24,16,24,24" Spacing="14">
            <TextBlock Text="设置" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="配置 AI 服务接口，用于崩溃分析与系统诊断。可保存多套配置，预设模板开箱即用。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="AI 服务配置" FontSize="18" FontWeight="SemiBold" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="选择 AI" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ComboBox x:Name="PresetBox" Width="300" HorizontalAlignment="Left" PlaceholderText="选择 AI 服务…"
                                  DisplayMemberPath="Name" SelectionChanged="PresetBox_SelectionChanged" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="接口地址 (Base URL)" />
                    <TextBox x:Name="BaseUrlBox" PlaceholderText="https://api.openai.com/v1" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="API Key（本地服务如 Ollama 可留空）" />
                    <PasswordBox x:Name="ApiKeyBox" PlaceholderText="sk-..." />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="模型名称（可手动输入，或点击“查询模型”自动获取该地址可用的模型后选择）" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ComboBox x:Name="ModelBox" IsEditable="True" Width="300" HorizontalAlignment="Left" />
                        <Button x:Name="FetchModelsButton" Click="FetchModels_Click" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="Refresh" />
                                <TextBlock Text="查询模型" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="FetchModelsTipText" Visibility="Collapsed" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Anthropic 协议无模型列表接口，请手动输入模型名称" />
                        <ProgressRing x:Name="ModelFetchRing" IsActive="False" Width="22" Height="22" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="发散度（0-1，值越低回答越严谨收敛，值越高越自由发散）" />
                    <Slider x:Name="TempSlider" Minimum="0" Maximum="1" StepFrequency="0.05" Width="300" HorizontalAlignment="Left" />
                    <TextBlock x:Name="TempValueText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="0.3（平衡：严谨为主，略有发散）" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="系统提示词（AI 的角色与回答要求，越详细结果越贴合你的需求）" />
                    <TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap" Height="160"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,14,0,0">
                        <Button x:Name="SaveButton" Click="Save_Click" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="Save" />
                                <TextBlock Text="保存配置" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TestButton" Click="Test_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="Play" />
                                <TextBlock Text="测试连接" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <ProgressRing x:Name="TestRing" IsActive="False" Width="22" Height="22" VerticalAlignment="Center" />
                    </StackPanel>
                    <InfoBar x:Name="SaveBar" IsOpen="False" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="支持的接口协议" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="预设覆盖主流协议，自定义项兼容任意 OpenAI 协议接口："
                               Margin="0,8,0,4" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="• OpenAI 协议：OpenAI、DeepSeek、智谱、Moonshot、通义、SiliconFlow 等" TextWrapping="Wrap" />
                    <TextBlock Text="• Anthropic 协议：Anthropic Claude（claude 系列模型）" TextWrapping="Wrap" />
                    <TextBlock Text="• Gemini 协议：Google Gemini（gemini 系列模型）" TextWrapping="Wrap" />
                    <TextBlock Text="• 自定义（OpenAI 兼容）：Ollama 本地（http://localhost:11434/v1，如 llama3.1）、vLLM、LM Studio 等" TextWrapping="Wrap" />
                    <TextBlock Text="配置保存位置：%LOCALAPPDATA%\BlueScreenHelper\settings.json（仅保存在本机，不会上传）"
                               Margin="0,10,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="关于" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Text="蓝屏诊断助手" Margin="0,8,0,0" />
                    <TextBlock Text="作者：Memories White" Margin="0,4,0,0" />
                    <TextBlock Text="功能：.dmp 转储解析 · 崩溃代码知识库 · 系统关键路径扫描 · AI 智能诊断" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Text="注意：本工具为辅助诊断软件，AI 提供的内容仅供参考，重大操作（如格式化、更换硬件）请谨慎执行。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
                        <Button x:Name="OpenLogButton" Click="OpenLogFolder_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="OpenFile" />
                                <TextBlock Text="打开日志文件夹" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CheckUpdateButton" Click="CheckUpdate_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="Download" />
                                <TextBlock Text="检查更新" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <ProgressRing x:Name="UpdateRing" IsActive="False" Width="22" Height="22" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="UpdateText" Margin="0,8,0,0" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <ProgressBar x:Name="DownloadBar" Minimum="0" Maximum="1" IsIndeterminate="False" Visibility="Collapsed" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
